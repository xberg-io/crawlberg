{
  "name": "@xberg-io/crawlberg-cli",
  "version": "1.13.6",
  "mcpName": "io.github.xberg-io/crawlberg",
  "description": "CLI proxy for crawlberg — runs the native crawlberg binary shipped in a per-platform package, downloading it from GitHub releases only as a fallback.",
  "license": "MIT",
  "author": {
    "name": "Na'aman Hirschfeld",
    "email": "naaman@xberg.io"
  },
  "contributors": [
    {
      "name": "Tobias Perlstein",
      "email": "tobias@xberg.io"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xberg-io/crawlberg.git",
    "directory": "cli-proxy/npm"
  },
  "bin": {
    "crawlberg": "bin/crawlberg.js"
  },
  "files": [
    "bin/",
    "install.js"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.23.0"
}
