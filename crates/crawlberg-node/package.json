{
  "author": {
    "name": "Na'aman Hirschfeld",
    "email": "naaman@xberg.io"
  },
  "contributors": [
    {
      "name": "Tobias Perlstein",
      "email": "tobias@xberg.io"
    }
  ],
  "name": "@xberg-io/crawlberg",
  "version": "1.12.2",
  "description": "High-performance web crawling engine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xberg-io/crawlberg.git"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "files": ["index.js", "binding.cjs", "index.mjs", "index.d.ts", "*.node"],
  "optionalDependencies": {
    "@xberg-io/crawlberg-darwin-arm64": "1.12.2",
    "@xberg-io/crawlberg-darwin-x64": "1.12.2",
    "@xberg-io/crawlberg-linux-arm64-gnu": "1.12.2",
    "@xberg-io/crawlberg-linux-x64-gnu": "1.12.2",
    "@xberg-io/crawlberg-win32-arm64-msvc": "1.12.2",
    "@xberg-io/crawlberg-win32-x64-msvc": "1.12.2"
  },
  "napi": {
    "packageName": "@xberg-io/crawlberg",
    "binaryName": "crawlberg-node",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "pnpm --package @napi-rs/cli@^3.7.3 dlx napi build --no-js --platform --dts index.native.d.ts --release",
    "artifacts": "pnpm --package @napi-rs/cli@^3.7.3 dlx napi artifacts",
    "prepublishOnly": "pnpm --package @napi-rs/cli@^3.7.3 dlx napi prepublish -t npm --skip-optional-publish"
  },
  "engines": {
    "node": ">= 22"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.9"
  },
  "packageManager": "pnpm@12.14.0"
}
