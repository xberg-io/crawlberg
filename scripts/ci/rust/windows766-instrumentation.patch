+            let span = tracing::debug_span!(target: "crawlberg::browser_pool::diagnostic",
+            "diagnostic_control", attempt = 3, generation = 11);
+            async {
+                tracing::debug!(target: "crawlberg::browser_pool::diagnostic", stage = "known_diagnostic_stage",
+                boundary = "begin", elapsed_ms = 0, "Windows acquisition diagnostic");
+            }
+            .instrument(span)
+            .await;
+        }
+        .with_subscriber(stage_dispatch),
+    )
+    .await
+    .expect("diagnostic stage producer must finish");
+    let stage_evidence = stage_capture.snapshot();
+    assert_eq!(
+        stage_evidence.lines().count(),
+        1,
+        "expected one stage diagnostic: {stage_evidence}"
+    );
+    for field in [
+        "known_diagnostic_stage",
+        "boundary=\"begin\"",
+        "attempt=3",
+        "generation=11",
+    ] {
+        assert!(stage_evidence.contains(field), "missing {field}: {stage_evidence}");
+    }
+}
