+// ~keep Issue #766 CI-only instrumentation; completion means resolution, including an error.
+pub(crate) async fn diagnostic_stage<T>(stage: &'static str, work: impl std::future::Future<Output = T>) -> T {
+    let mut record = PageOpenDiagnosticStage {
+        stage,
+        started: std::time::Instant::now(),
+        completed: false,
+    };
+    record.emit("begin");
+    let result = work.await;
+    record.completed = true;
+    result
+}
+
+struct PageOpenDiagnosticStage {
+    stage: &'static str,
+    started: std::time::Instant,
+    completed: bool,
+}
+
+impl PageOpenDiagnosticStage {
+    fn emit(&self, boundary: &'static str) {
+        tracing::debug!(
+            target: "crawlberg::browser_pool::diagnostic",
+            stage = self.stage,
+            boundary,
+            elapsed_ms = self.started.elapsed().as_millis(),
+            "Windows acquisition diagnostic"
+        );
+    }
+}
+
+impl Drop for PageOpenDiagnosticStage {
+    fn drop(&mut self) {
+        self.emit(if self.completed { "complete" } else { "dropped" });
+    }
 }
 
