{
	"id": "metadata_hreflang",
	"description": "Extracts hreflang alternate link tags",
	"docs": {
		"topic": "metadata",
		"stem": "metadata-hreflang",
		"title": "Extracts hreflang alternate link tags"
	},
	"tags": ["metadata"],
	"input": {
		"config": {},
		"mock_responses": [
			{
				"status_code": 200,
				"headers": {
					"content-type": "text/html; charset=utf-8"
				},
				"body_file": "html/comprehensive_metadata.html"
			}
		]
	},
	"assertions": [
		{
			"type": "equals",
			"field": "status_code",
			"value": 200
		},
		{
			"type": "equals",
			"field": "hreflang.length",
			"value": 4,
			"skip": {
				"languages": ["swift"],
				"kind": "language_limitation",
				"reason": "swift-bridge JSON-bridges Option<Vec<T>> getters to a single RustString, which has no .count, so a trailing .length segment cannot compile in Swift"
			}
		},
		{
			"type": "contains",
			"field": "hreflang[].lang",
			"value": "en"
		}
	]
}
