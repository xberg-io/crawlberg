{
	"id": "metadata_headings",
	"description": "Extracts heading hierarchy (h1-h6) from HTML page",
	"docs": {
		"topic": "metadata",
		"stem": "metadata-headings",
		"title": "Extracts heading hierarchy (h1-h6) from HTML page"
	},
	"tags": ["metadata"],
	"input": {
		"config": {},
		"mock_responses": [
			{
				"status_code": 200,
				"headers": {
					"content-type": "text/html; charset=utf-8"
				},
				"body_file": "html/headings_hierarchy.html"
			}
		]
	},
	"assertions": [
		{
			"type": "equals",
			"field": "status_code",
			"value": 200
		},
		{
			"type": "equals",
			"field": "headings[0].level",
			"value": 1
		},
		{
			"type": "equals",
			"field": "headings[0].text",
			"value": "Primary Heading"
		},
		{
			"type": "equals",
			"field": "headings.length",
			"value": 8,
			"skip": {
				"languages": ["swift"],
				"kind": "language_limitation",
				"reason": "swift-bridge JSON-bridges Option<Vec<T>> getters to a single RustString, which has no .count, so a trailing .length segment cannot compile in Swift"
			}
		}
	]
}
