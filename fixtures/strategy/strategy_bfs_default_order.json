{
	"id": "strategy_bfs_default_order",
	"description": "BFS strategy visits pages in breadth-first order",
	"docs": {
		"topic": "strategy",
		"stem": "strategy-bfs-default-order",
		"title": "BFS strategy visits pages in breadth-first order"
	},
	"tags": [
		"strategy",
		"bfs",
		"crawl"
	],
	"input": {
		"mock_responses": [
			{
				"path": "/",
				"headers": {
					"content-type": "text/html"
				},
				"body_inline": "<html><body><a href=\"/alpha\">A</a><a href=\"/beta\">B</a></body></html>"
			},
			{
				"path": "/alpha",
				"headers": {
					"content-type": "text/html"
				},
				"body_inline": "<html><body><a href=\"/one\">One</a></body></html>"
			},
			{
				"path": "/beta",
				"headers": {
					"content-type": "text/html"
				},
				"body_inline": "<html><body><a href=\"/two\">Two</a></body></html>"
			},
			{
				"path": "/one",
				"headers": {
					"content-type": "text/html"
				},
				"body_inline": "<html><body><h1>One</h1></body></html>"
			},
			{
				"path": "/two",
				"headers": {
					"content-type": "text/html"
				},
				"body_inline": "<html><body><h1>Two</h1></body></html>"
			}
		],
		"config": {
			"max_depth": 2,
			"max_concurrent": 1,
			"crawl_strategy": "bfs"
		}
	},
	"assertions": [
		{
			"type": "equals",
			"field": "crawl.pages_crawled",
			"value": 5
		},
		{
			"type": "contains",
			"field": "strategy.page_1_url",
			"value": "alpha"
		},
		{
			"type": "contains",
			"field": "strategy.page_2_url",
			"value": "beta"
		},
		{
			"type": "contains",
			"field": "strategy.page_3_url",
			"value": "one"
		},
		{
			"type": "contains",
			"field": "strategy.page_4_url",
			"value": "two"
		}
	]
}
