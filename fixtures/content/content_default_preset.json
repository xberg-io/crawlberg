{
	"id": "content_default_preset",
	"description": "Default preprocessing keeps the footer that the aggressive preset drops",
	"docs": {
		"topic": "content",
		"stem": "content-default-preset",
		"title": "Default preprocessing keeps the footer that the aggressive preset drops"
	},
	"tags": ["content", "extraction"],
	"input": {
		"mock_responses": [
			{
				"status_code": 200,
				"headers": {
					"content-type": "text/html; charset=utf-8"
				},
				"body_file": "html/main_content_page.html"
			}
		],
		"config": {
			"respect_robots_txt": false
		}
	},
	"assertions": [
		{
			"type": "contains",
			"field": "markdown.content",
			"value": "Main Article Title"
		},
		{
			"type": "contains",
			"field": "markdown.content",
			"value": "Footer content"
		},
		{
			"type": "not_contains",
			"field": "markdown.content",
			"value": "Sidebar content"
		}
	]
}
