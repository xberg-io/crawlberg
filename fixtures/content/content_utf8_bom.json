				"body_file": "html/utf8_bom.html"
			}
		],
		"config": {
			"respect_robots_txt": false
		}
	},
	"assertions": [
		{
			"type": "equals",
			"field": "content.detected_charset",
			"value": "utf-8"
		},
		{
			"type": "not_empty",
			"field": "html"
		}
	]
}
