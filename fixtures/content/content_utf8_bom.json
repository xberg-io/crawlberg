{
	"id": "content_utf8_bom",
	"description": "Handles UTF-8 content with BOM marker correctly",
	"docs": {
		"topic": "content",
		"stem": "content-utf8-bom",
		"title": "Handles UTF-8 content with BOM marker correctly"
	},
	"tags": ["content", "charset"],
