{
	"id": "engine_scrape_basic",
	"description": "CrawlEngine with defaults scrapes a page identically to the free function",
	"docs": {
		"topic": "getting-started",
		"stem": "basic_usage",
		"title": "Basic usage"
	},
	"tags": ["engine", "scrape"],
	"input": {
		"mock_responses": [
			{
				"status_code": 200,
				"headers": {
					"content-type": "text/html"
				},
				"body_inline": "<html><head><title>Engine Test</title><meta name=\"description\" content=\"Testing the engine\"></head><body><h1>Hello Engine</h1><a href=\"/page2\">Link</a></body></html>"
			}
		],
		"config": {}
	},
	"assertions": [
		{
			"type": "equals",
			"field": "status_code",
			"value": 200
		},
		{
			"type": "equals",
			"field": "content_type",
			"value": "text/html"
		},
		{
			"type": "equals",
			"field": "metadata.title",
			"value": "Engine Test"
		},
		{
			"type": "contains",
			"field": "metadata.description",
			"value": "Testing the engine"
		},
		{
			"type": "greater_than_or_equal",
			"field": "links.length",
			"value": 1
		},
		{
			"type": "greater_than_or_equal",
			"field": "metadata.headings.length",
			"value": 1,
			"skip": {
				"languages": ["swift"],
				"kind": "language_limitation",
				"reason": "swift-bridge JSON-bridges Option<Vec<T>> getters to a single RustString, which has no .count, so a trailing .length segment cannot compile in Swift"
			}
		}
	]
}
