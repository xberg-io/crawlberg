{
	"id": "robots_crawl_disallow_blocks_child",
	"description": "Crawl skips child URLs disallowed by robots.txt",
	"docs": {
		"topic": "robots",
		"stem": "robots-crawl-disallow-blocks-child",
		"title": "Crawl skips child URLs disallowed by robots.txt"
	},
	"tags": ["robots", "crawl"],
	"input": {
		"mock_responses": [
			{
				"path": "/robots.txt",
				"status_code": 200,
				"headers": {
					"content-type": "text/plain"
				},
				"body_inline": "User-agent: *\nDisallow: /private\n"
			},
			{
				"path": "/",
				"status_code": 200,
				"headers": {
					"content-type": "text/html; charset=utf-8"
				},
				"body_inline": "<html><body><h1>Home</h1><a href=\"/private/secret\">Secret</a><a href=\"/public\">Public</a></body></html>"
			},
			{
				"path": "/private/secret",
				"status_code": 200,
				"headers": {
					"content-type": "text/html; charset=utf-8"
				},
				"body_inline": "<html><body><h1>Secret</h1></body></html>"
			},
			{
				"path": "/public",
				"status_code": 200,
				"headers": {
					"content-type": "text/html; charset=utf-8"
				},
				"body_inline": "<html><body><h1>Public</h1></body></html>"
			}
		],
		"config": {
			"max_depth": 1,
			"respect_robots_txt": true
		}
	},
	"assertions": [
		{
			"type": "equals",
			"field": "pages.length",
			"value": 2
		}
	]
}
