{
	"id": "robots_crawl_unreachable_5xx",
	"description": "Crawl stops before any fetch when robots.txt is unreachable",
	"docs": {
		"topic": "robots",
		"stem": "robots-crawl-unreachable-5xx",
		"title": "Crawl stops before any fetch when robots.txt is unreachable"
	},
	"tags": ["robots", "crawl"],
	"input": {
		"mock_responses": [
			{
				"path": "/robots.txt",
				"status_code": 503,
				"headers": {
					"content-type": "text/plain"
				},
				"body_inline": "Service Unavailable"
			},
			{
				"path": "/",
				"status_code": 200,
				"headers": {
					"content-type": "text/html; charset=utf-8"
				},
				"body_inline": "<html><body><h1>Home</h1><a href=\"/page1\">Page 1</a></body></html>"
			},
			{
				"path": "/page1",
				"status_code": 200,
				"headers": {
					"content-type": "text/html; charset=utf-8"
				},
				"body_inline": "<html><body><h1>Page 1</h1></body></html>"
			}
		],
		"config": {
			"max_depth": 1,
			"respect_robots_txt": true
		}
	},
	"assertions": [
		{
			"type": "equals",
			"field": "pages.length",
			"value": 0
		},
		{
			"type": "equals",
			"field": "content.was_skipped",
			"value": true
		},
		{
			"type": "contains",
			"field": "error",
			"value": "robots_unreachable"
		}
	]
}
