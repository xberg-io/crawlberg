{
	"id": "redirect_loop",
	"description": "Detects redirect loop (A -> B -> A) and stops following without reaching a final page",
	"docs": {
		"topic": "redirect",
		"stem": "redirect-loop",
		"title": "Detects redirect loop (A -> B -> A) and stops following without reaching a final page"
	},
	"tags": ["redirect", "error", "crawl"],
	"input": {
		"mock_responses": [
			{
				"path": "/",
				"method": "GET",
				"status_code": 302,
				"headers": {
					"location": "/a"
				},
				"body_inline": ""
			},
			{
				"path": "/a",
				"method": "GET",
				"status_code": 302,
				"headers": {
					"location": "/"
				},
				"body_inline": ""
			}
		],
		"config": {
			"respect_robots_txt": false
		}
	},
	"assertions": [
		{
			"type": "equals",
			"field": "redirect_count",
			"value": 1
		},
		{
			"type": "equals",
			"field": "pages[0].status_code",
			"value": 302
		}
	]
}
