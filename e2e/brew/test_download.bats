  fi
  val_downloaded_document_mime_type=${val_downloaded_document_mime_type%.}
  val_downloaded_document_mime_type=${val_downloaded_document_mime_type%$'\n'}
  [[ "$val_downloaded_document_mime_type" == 'application/pdf' ]]
