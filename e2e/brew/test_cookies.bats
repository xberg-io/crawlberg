  local val_cookies
  if ! val_cookies=$(
    jq -r -s '
      if length == 1 then .[0] | (.cookies) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [cookies]: cannot extract JSON value' >&2
    return 1
  fi
  val_cookies=${val_cookies%.}
  val_cookies=${val_cookies%$'\n'}
  [[ "$val_cookies" == *'domain_cookie'* ]]
}

