@test "rate_limit_adaptive_backoff" {
  # Exponential backoff retry succeeds after 429 Too Many Requests
  local output
  output=$(crawlberg scrape "${MOCK_SERVER_RATE_LIMIT_ADAPTIVE_BACKOFF:-${MOCK_SERVER_URL}/fixtures/rate_limit_adaptive_backoff}" --config '{"respect_robots_txt":false,"retry_codes":[429],"retry_count":2}' --format json --browser-mode never)

