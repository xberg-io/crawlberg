@test "batch_scrape_empty_urls_error" {
  # Batch scrape with empty batch_urls array returns error
  if output=$(crawlberg batch-scrape --config '{}' --format json --browser-mode never 2>&1); then
    echo 'FAIL [error]: expected command to fail but it succeeded' >&2
    return 1
  fi
  if ! grep -qF 'urls' <<<"$output"; then
    echo 'FAIL [error]: expected output to contain ''urls' >&2
    return 1
  fi
}

