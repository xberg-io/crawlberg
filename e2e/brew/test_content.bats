  # Handles 204 No Content response gracefully
  local output
  output=$(crawlberg scrape "${MOCK_SERVER_CONTENT_204_NO_CONTENT:-${MOCK_SERVER_URL}/fixtures/content_204_no_content}" --config '{}' --format json --browser-mode never)

