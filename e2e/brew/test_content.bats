    return 1
  fi
  val_status_code=${val_status_code%.}
  val_status_code=${val_status_code%$'\n'}
  [[ "$val_status_code" == '204' ]]
  local val_html
  if ! val_html=$(
    jq -r -s '
      if length == 1 then .[0] | (.html // empty) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [html]: cannot extract JSON value' >&2
    return 1
  fi
  val_html=${val_html%.}
  val_html=${val_html%$'\n'}
  [[ -z "$val_html" ]]
}

