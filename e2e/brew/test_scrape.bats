  local val_json_ld_name
  if ! val_json_ld_name=$(
    jq -r -s '
      if length == 1 then .[0] | (.json_ld[].name) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [json_ld.name]: cannot extract JSON value' >&2
    return 1
  fi
  val_json_ld_name=${val_json_ld_name%.}
  val_json_ld_name=${val_json_ld_name%$'\n'}
  [[ "$val_json_ld_name" == 'Best Chocolate Cake' ]]
}

@test "scrape_malformed_html" {
  # Gracefully handles broken HTML without crashing
  local output
  output=$(crawlberg scrape "${MOCK_SERVER_SCRAPE_MALFORMED_HTML:-${MOCK_SERVER_URL}/fixtures/scrape_malformed_html}" --config '{}' --format json --browser-mode never)

  local val_status_code
  if ! val_status_code=$(
    jq -r -s '
      if length == 1 then .[0] | (.status_code) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [status_code]: cannot extract JSON value' >&2
    return 1
  fi
  val_status_code=${val_status_code%.}
  val_status_code=${val_status_code%$'\n'}
  [[ "$val_status_code" == '200' ]]
  local val_html
  if ! val_html=$(
    jq -r -s '
      if length == 1 then .[0] | (.html) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [html]: cannot extract JSON value' >&2
    return 1
  fi
  val_html=${val_html%.}
  val_html=${val_html%$'\n'}
  [[ -n "$val_html" && "$val_html" != null && "$val_html" != '[]' && "$val_html" != '{}' ]]
  local val_metadata_title
  if ! val_metadata_title=$(
    jq -r -s '
      if length == 1 then .[0] | (.metadata.title) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [metadata.title]: cannot extract JSON value' >&2
    return 1
  fi
  val_metadata_title=${val_metadata_title%.}
  val_metadata_title=${val_metadata_title%$'\n'}
  [[ "$val_metadata_title" == *'Malformed Page'* ]]
  local val_metadata_description
  if ! val_metadata_description=$(
    jq -r -s '
      if length == 1 then .[0] | (.metadata.description // empty) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [metadata.description]: cannot extract JSON value' >&2
    return 1
  fi
  val_metadata_description=${val_metadata_description%.}
  val_metadata_description=${val_metadata_description%$'\n'}
  [[ -z "$val_metadata_description" ]]
}

