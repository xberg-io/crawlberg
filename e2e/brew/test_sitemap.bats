@test "sitemap_basic" {
  # Parses a standard urlset sitemap
  local output
  output=$(crawlberg map "${MOCK_SERVER_SITEMAP_BASIC:-${MOCK_SERVER_URL}/fixtures/sitemap_basic}" --config '{}' --format json --browser-mode never)

  local val_urls_length
  if ! val_urls_length=$(
    jq -r -s '
      if length == 1 then .[0] | (.urls | length) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [urls.length]: cannot extract JSON value' >&2
    return 1
  fi
  val_urls_length=${val_urls_length%.}
  val_urls_length=${val_urls_length%$'\n'}
  [[ "$val_urls_length" == '4' ]]
}

