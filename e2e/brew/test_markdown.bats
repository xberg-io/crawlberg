  # Markdown includes citation conversion with numbered references
  local output
  output=$(crawlberg scrape "${MOCK_SERVER_MARKDOWN_WITH_CITATIONS:-${MOCK_SERVER_URL}/fixtures/markdown_with_citations}" --config '{}' --format json --browser-mode never)

  local val_status_code
  if ! val_status_code=$(
    jq -r -s '
      if length == 1 then .[0] | (.status_code) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [status_code]: cannot extract JSON value' >&2
    return 1
  fi
  val_status_code=${val_status_code%.}
  val_status_code=${val_status_code%$'\n'}
  [[ "$val_status_code" == '200' ]]
  local val_markdown_content
  if ! val_markdown_content=$(
    jq -r -s '
      if length == 1 then .[0] | (.markdown.content) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [markdown.content]: cannot extract JSON value' >&2
    return 1
  fi
  val_markdown_content=${val_markdown_content%.}
  val_markdown_content=${val_markdown_content%$'\n'}
  [[ -n "$val_markdown_content" && "$val_markdown_content" != null && "$val_markdown_content" != '[]' && "$val_markdown_content" != '{}' ]]
}
