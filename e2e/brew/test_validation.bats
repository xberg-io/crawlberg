@test "validation_browser_endpoint_invalid" {
  # Browser endpoint must be a valid ws:// or wss:// URL, not http://
  if output=$(crawlberg scrape "${MOCK_SERVER_VALIDATION_BROWSER_ENDPOINT_INVALID:-${MOCK_SERVER_URL}/fixtures/validation_browser_endpoint_invalid}" --config '{"browser":{"endpoint":"http://not-websocket:3000","mode":"always"}}' --format json --browser-mode never 2>&1); then
    echo 'FAIL [error]: expected command to fail but it succeeded' >&2
    return 1
  fi
  if ! grep -qF 'endpoint' <<<"$output"; then
    echo 'FAIL [error]: expected output to contain ''endpoint' >&2
    return 1
  fi
}

