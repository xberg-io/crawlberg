@test "validation_ssrf_allowlisted_loopback" {
  # SSRF allowlist permits a loopback mock server while private-network protection remains enabled
  local output
  output=$(crawlberg scrape "${MOCK_SERVER_VALIDATION_SSRF_ALLOWLISTED_LOOPBACK:-${MOCK_SERVER_URL}/fixtures/validation_ssrf_allowlisted_loopback}" --config '{"respect_robots_txt":false,"ssrf":{"allowlist":[{"type":"cidr","value":"127.0.0.0/8"}],"deny_private":true,"max_redirects":5},"ssrf_deny_private_explicit":true}' --format json --browser-mode never)

  local val_status_code
  if ! val_status_code=$(
    jq -r -s '
      if length == 1 then .[0] | (.status_code) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [status_code]: cannot extract JSON value' >&2
    return 1
  fi
  val_status_code=${val_status_code%.}
  val_status_code=${val_status_code%$'\n'}
  [[ "$val_status_code" == '200' ]]
  local val_metadata_title
  if ! val_metadata_title=$(
    jq -r -s '
      if length == 1 then .[0] | (.metadata.title) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [metadata.title]: cannot extract JSON value' >&2
    return 1
  fi
  val_metadata_title=${val_metadata_title%.}
  val_metadata_title=${val_metadata_title%$'\n'}
  [[ "$val_metadata_title" == 'Allowlisted' ]]
}

@test "validation_ssrf_ipv4_mapped_ipv6_denied" {
  # SSRF policy rejects an IPv4 loopback address embedded in an IPv6 literal
  if output=$(crawlberg scrape 'http://[::ffff:127.0.0.1]/' --config '{"ssrf":{"deny_private":true},"ssrf_deny_private_explicit":true}' --format json --browser-mode never 2>&1); then
    echo 'FAIL [error]: expected command to fail but it succeeded' >&2
    return 1
  fi
  if ! grep -qF 'ssrf_policy_violation' <<<"$output"; then
    echo 'FAIL [error]: expected output to contain ''ssrf_policy_violation' >&2
    return 1
  fi
}

@test "validation_ssrf_loopback_denied" {
  # scrape() rejects loopback addresses by default SSRF policy
  if output=$(crawlberg scrape 'http://127.0.0.1:9/' --config '{"ssrf_deny_private_explicit":true}' --format json --browser-mode never 2>&1); then
    echo 'FAIL [error]: expected command to fail but it succeeded' >&2
    return 1
  fi
  if ! grep -qF 'ssrf_policy_violation' <<<"$output"; then
    echo 'FAIL [error]: expected output to contain ''ssrf_policy_violation' >&2
    return 1
  fi
}

@test "validation_ssrf_nat64_loopback_denied" {
  # SSRF policy rejects an IPv4 loopback address embedded in the well-known NAT64 prefix
  if output=$(crawlberg scrape 'http://[64:ff9b::7f00:1]/' --config '{"ssrf":{"deny_private":true},"ssrf_deny_private_explicit":true}' --format json --browser-mode never 2>&1); then
    echo 'FAIL [error]: expected command to fail but it succeeded' >&2
