@test "encoding_double_encoded" {
  # Handles double-encoded URL characters (%25C3%25B6)
  local output
  output=$(crawlberg scrape "${MOCK_SERVER_ENCODING_DOUBLE_ENCODED:-${MOCK_SERVER_URL}/fixtures/encoding_double_encoded}" --config '{}' --format json --browser-mode never)

  local val_html
  if ! val_html=$(
    jq -r -s '
      if length == 1 then .[0] | (.html) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [html]: cannot extract JSON value' >&2
    return 1
  fi
  val_html=${val_html%.}
  val_html=${val_html%$'\n'}
  [[ -n "$val_html" && "$val_html" != null && "$val_html" != '[]' && "$val_html" != '{}' ]]
  local val_links_length
  if ! val_links_length=$(
    jq -r -s '
      if length == 1 then .[0] | (.links | length) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [links.length]: cannot extract JSON value' >&2
    return 1
  fi
  val_links_length=${val_links_length%.}
  val_links_length=${val_links_length%$'\n'}
  jq -en --arg actual "$val_links_length" --arg expected '1' '($actual | tonumber) >= ($expected | tonumber)' >/dev/null
}

