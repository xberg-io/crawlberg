  [[ "$val_browser_used" == 'true' ]]
}

@test "browser_profile_basic" {
  # Browser profile configuration persists and reuses browser state across crawl sessions
  local output
  output=$(crawlberg scrape "${MOCK_SERVER_BROWSER_PROFILE_BASIC:-${MOCK_SERVER_URL}/fixtures/browser_profile_basic}" --config '{"browser":{"mode":"always"},"browser_profile":"test-profile"}' --format json --browser-mode never)

  local val_browser_used
  if ! val_browser_used=$(
    jq -r -s '
      if length == 1 then .[0] | (.browser_used) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [browser_used]: cannot extract JSON value' >&2
    return 1
  fi
  val_browser_used=${val_browser_used%.}
  val_browser_used=${val_browser_used%$'\n'}
  [[ "$val_browser_used" == 'true' ]]
  local val_status_code
  if ! val_status_code=$(
    jq -r -s '
      if length == 1 then .[0] | (.status_code) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
