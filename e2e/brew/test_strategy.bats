@test "strategy_adaptive_saturation" {
  # Adaptive strategy stops early when encountering saturation (duplicate content)
  local output
  output=$(crawlberg crawl "${MOCK_SERVER_STRATEGY_ADAPTIVE_SATURATION:-${MOCK_SERVER_URL}/fixtures/strategy_adaptive_saturation}" --config '{"crawl_strategy":"best_first","max_concurrent":1,"max_depth":2,"respect_robots_txt":false}' --format json --browser-mode never)

  local val_crawl_pages_crawled
  if ! val_crawl_pages_crawled=$(
    jq -r -s '
      if length == 1 then .[0] | (.pages | length) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [crawl.pages_crawled]: cannot extract JSON value' >&2
    return 1
  fi
  val_crawl_pages_crawled=${val_crawl_pages_crawled%.}
  val_crawl_pages_crawled=${val_crawl_pages_crawled%$'\n'}
  jq -en --arg actual "$val_crawl_pages_crawled" --arg expected '1' '($actual | tonumber) >= ($expected | tonumber)' >/dev/null
}

@test "strategy_adaptive_window" {
  # Adaptive strategy crawls more pages when content is diverse
