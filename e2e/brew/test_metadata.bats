    printf '%s\n' 'FAIL [response_headers.last_modified]: cannot extract JSON value' >&2
    return 1
  fi
  val_response_headers_last_modified=${val_response_headers_last_modified%.}
  val_response_headers_last_modified=${val_response_headers_last_modified%$'\n'}
  [[ "$val_response_headers_last_modified" == *'01 Jan 2025'* ]]
  local val_response_headers_server
  if ! val_response_headers_server=$(
    jq -r -s '
      if length == 1 then .[0] | (.response_meta.server) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [response_headers.server]: cannot extract JSON value' >&2
    return 1
  fi
  val_response_headers_server=${val_response_headers_server%.}
  val_response_headers_server=${val_response_headers_server%$'\n'}
  [[ "$val_response_headers_server" == *'nginx'* ]]
  local val_response_headers_content_language
  if ! val_response_headers_content_language=$(
    jq -r -s '
      if length == 1 then .[0] | (.response_meta.content_language) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [response_headers.content_language]: cannot extract JSON value' >&2
    return 1
  fi
  val_response_headers_content_language=${val_response_headers_content_language%.}
  val_response_headers_content_language=${val_response_headers_content_language%$'\n'}
  [[ "$val_response_headers_content_language" == 'en-US' ]]
}

@test "metadata_word_count" {
  # Computes word count from visible page text
  local output
  output=$(crawlberg scrape "${MOCK_SERVER_METADATA_WORD_COUNT:-${MOCK_SERVER_URL}/fixtures/metadata_word_count}" --config '{}' --format json --browser-mode never)

  local val_status_code
  if ! val_status_code=$(
    jq -r -s '
      if length == 1 then .[0] | (.status_code) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [status_code]: cannot extract JSON value' >&2
    return 1
  fi
  val_status_code=${val_status_code%.}
  val_status_code=${val_status_code%$'\n'}
  [[ "$val_status_code" == '200' ]]
  local val_metadata_word_count
  if ! val_metadata_word_count=$(
    jq -r -s '
      if length == 1 then .[0] | (.metadata.word_count) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [metadata.word_count]: cannot extract JSON value' >&2
    return 1
  fi
  val_metadata_word_count=${val_metadata_word_count%.}
  val_metadata_word_count=${val_metadata_word_count%$'\n'}
  jq -en --arg actual "$val_metadata_word_count" --arg expected '99' '($actual | tonumber) > ($expected | tonumber)' >/dev/null
  local val_metadata_word_count
  if ! val_metadata_word_count=$(
    jq -r -s '
      if length == 1 then .[0] | (.metadata.word_count) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [metadata.word_count]: cannot extract JSON value' >&2
    return 1
  fi
  val_metadata_word_count=${val_metadata_word_count%.}
  val_metadata_word_count=${val_metadata_word_count%$'\n'}
  jq -en --arg actual "$val_metadata_word_count" --arg expected '301' '($actual | tonumber) < ($expected | tonumber)' >/dev/null
}
