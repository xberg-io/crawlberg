  local output
  output=$(crawlberg crawl "${MOCK_SERVER_CRAWL_QUERY_IDENTITY_LEGACY:-${MOCK_SERVER_URL}/fixtures/crawl_query_identity_legacy}" --config '{"dedup_include_query":false,"max_depth":1,"respect_robots_txt":false}' --format json --browser-mode never)

  local val_pages_length
  if ! val_pages_length=$(
    jq -r -s '
      if length == 1 then .[0] | (.pages | length) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [pages.length]: cannot extract JSON value' >&2
    return 1
  fi
  val_pages_length=${val_pages_length%.}
  val_pages_length=${val_pages_length%$'\n'}
  [[ "$val_pages_length" == '2' ]]
}

