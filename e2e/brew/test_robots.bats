@test "robots_unreachable_5xx" {
  # Unreachable robots.txt (503) reports is_allowed false
  local output
  output=$(crawlberg scrape "${MOCK_SERVER_ROBOTS_UNREACHABLE_5XX:-${MOCK_SERVER_URL}/fixtures/robots_unreachable_5xx}" --config '{"respect_robots_txt":true}' --format json --browser-mode never)

  local val_robots_is_allowed
  if ! val_robots_is_allowed=$(
    jq -r -s '
      if length == 1 then .[0] | (.is_allowed) else error("expected one JSON result") end
    ' <<<"$output" || exit "$?"
    printf '.'
  ); then
    printf '%s\n' 'FAIL [robots.is_allowed]: cannot extract JSON value' >&2
    return 1
  fi
  val_robots_is_allowed=${val_robots_is_allowed%.}
  val_robots_is_allowed=${val_robots_is_allowed%$'\n'}
  [[ "$val_robots_is_allowed" == 'false' ]]
}

