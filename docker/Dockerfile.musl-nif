# =============================================================================
# =============================================================================
FROM alpine:3.21 AS builder

WORKDIR /build

RUN apk add --no-cache \
    curl gcc g++ musl-dev cmake make pkgconf \
    openssl-dev openssl-libs-static \
    perl linux-headers git file

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain stable --component rust-src && \
    echo "Rust host: $(~/.cargo/bin/rustc -vV | grep host)" && \
    echo "Default target: $(~/.cargo/bin/rustc --print cfg | grep target)"
ENV PATH="/root/.cargo/bin:${PATH}"

ENV RUSTFLAGS="-C target-feature=-crt-static"

COPY Cargo.toml Cargo.lock ./
COPY vendor/crawlberg-chromiumoxide/ vendor/crawlberg-chromiumoxide/
COPY crates/crawlberg/ crates/crawlberg/
COPY crates/crawlberg-robots/ crates/crawlberg-robots/
COPY crates/crawlberg-bindings-common/ crates/crawlberg-bindings-common/
COPY crates/crawlberg-browser/ crates/crawlberg-browser/
COPY packages/elixir/native/crawlberg_nif/ packages/elixir/native/crawlberg_nif/

# The NIF crate is its own workspace, with its own Cargo.lock, so the root members list stays as is.
RUN . "$HOME/.cargo/env" && \
    cargo build --release --manifest-path packages/elixir/native/crawlberg_nif/Cargo.toml && \
    cp packages/elixir/native/crawlberg_nif/target/release/libcrawlberg_nif.so /build/libcrawlberg_nif.so && \
    strip /build/libcrawlberg_nif.so

RUN file /build/libcrawlberg_nif.so && \
    echo "=== Dynamic dependencies ===" && \
    readelf -d /build/libcrawlberg_nif.so 2>/dev/null | grep NEEDED || echo "No dynamic dependencies (fully static)"

FROM scratch
COPY --from=builder /build/libcrawlberg_nif.so /libcrawlberg_nif.so
